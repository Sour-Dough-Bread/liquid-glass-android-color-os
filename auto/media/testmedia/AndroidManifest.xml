<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.stockglass.auto.testmedia"
    android:versionCode="2"
    android:versionName="0.2">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:label="Glass Test Media" android:icon="@android:drawable/ic_media_play">
        <meta-data android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Starts the player; finishes at once. -->
        <activity android:name=".Start" android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Artwork for the browse tree (content:// icon URIs). -->
        <provider android:name=".ArtProvider"
            android:authorities="dev.stockglass.auto.testmedia.art"
            android:exported="true" />

        <service android:name=".Player" android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
