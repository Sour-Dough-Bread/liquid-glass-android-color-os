// StockGlass: Liquid Glass for SurfaceFlinger's blur regions, built in.
//
// The StockGlass engine's drawing code, the shader and its parameter tables,
// as the module ships them, compiled against RenderEngine's Skia.
// librenderengine takes it whole (whole_static_libs) and drives it from
// skia/filters/GlassFilter.cpp.
//
// Generated by rom/make_patch.sh from github.com/capthndsme/liquid-glass-android:
// change the sources there and generate the patch again; do not edit them here.
// Its own library because the engine's sources name their own log tag
// ("StockGlass"), which renderengine_defaults' -DLOG_TAG would collide with.

package {
    // NOTE: the StockGlass sources carry no licence of their own yet; this
    // assumes they come under frameworks/native's (Apache-2.0). See rom/README.md.
    default_applicable_licenses: ["frameworks_native_license"],
}

cc_library_static {
    name: "librenderengine_glass",
    // renderengine_defaults' warnings, without its LOG_TAG.
    cflags: [
        "-Wall",
        "-Werror",
        "-Wthread-safety",
        "-Wunused",
        "-Wunreachable-code",
        "-fvisibility=hidden",
        "-Werror=format",
        "-Wno-unused-parameter",
    ],
    srcs: [
        "crash_guard.cpp",
        "glass_draw.cpp",
        "glass_params.cpp",
        "sk_shared.cpp",
        "skia_native.cpp",
    ],
    static_libs: [
        "libskia_renderengine",
    ],
    shared_libs: [
        "liblog",
    ],
}
