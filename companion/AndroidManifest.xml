<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.stockglass.companion"
    android:versionCode="3"
    android:versionName="0.2.1">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="36" />

    <!-- No activity and no native code: it is configured through the same
         persist.sys.glass.* properties as the engine (glassctl, the WebUI). -->
    <application android:label="Stock Glass Companion">
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="Liquid Glass on Quick Settings, the launcher, the text toolbar, the screenshot bar and the lockscreen clock. Draws nothing unless the Stock Glass module is in glass mode." />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope"
            android:value="android;com.android.systemui;com.android.launcher3;com.google.android.apps.nexuslauncher" />
    </application>
</manifest>
